{
  "name": "lck-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/engine.test.ts",
    "test:e2e": "playwright test",
    "package:offline": "npm run build && python3 scripts/package_offline.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1"
  }
}
